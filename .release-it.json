{
	"$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
	"npm": {
		"publish": false
	},
	"github": false,
	"git": {
		"commitMessage": "chore(release): v${version}",
		"tagName": "v${version}",
		"tagAnnotation": "Release v${version}"
	},
	"hooks": {
		"after:bump": "bun scripts/set-versions.ts ${version} && git add project.yml Blather/Resources/Info.plist"
	}
}
