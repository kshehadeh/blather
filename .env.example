# Blather runtime options (non-secret only). Secrets are entered through the
# Settings UI and stored in macOS Keychain, never here.

# Where local data lives (SQLite DB, uploaded media). Default: ~/.blather
# BLATHER_DATA_DIR=~/.blather

# Port is set via CLI flags; servers always bind to 127.0.0.1.
# Example: bun run dev -- --port 3000  (or)  bun run start -- --port 3000

# Testing hooks (never set in real use):
# BLATHER_KEYCHAIN=memory   # use in-memory credential store instead of Keychain
# BLATHER_R2=fake           # use in-memory R2 staging
# BLATHER_MOCK_PROVIDERS=1  # use mock provider adapters (no external calls)
